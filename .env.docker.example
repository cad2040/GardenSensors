# Copy to .env.docker (optional) or export before `docker-compose up`.
# Defaults are already set in docker-compose.yml for local use.

MYSQL_ROOT_PASSWORD=newrootpassword
DB_NAME=garden_sensors
DB_USER=garden_sensors
DB_PASS=garden_sensors
WEB_PORT=8080
MYSQL_PORT=3307
APP_URL=http://localhost:8080

# App DB connection inside compose network uses host "db"
DB_HOST=db

# Optional plant catalog import during `setup.sh docker` (off by default)
# Prefer: SEED_PLANT_CATALOG=1 sudo -E ./setup.sh docker
# SEED_PLANT_CATALOG=0
# PLANT_CATALOG_FILE=database/catalog/plant_catalog.csv
